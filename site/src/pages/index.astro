---
import BaseLayout from "../layouts/BaseLayout.astro";
import DigestCard from "../components/DigestCard.astro";
import { getCollection, type CollectionEntry } from "astro:content";

const base = import.meta.env.BASE_URL || "/";
function withBase(path: string): string {
  const b = base.endsWith("/") ? base.slice(0, -1) : base;
  const p = path.startsWith("/") ? path : `/${path}`;
  return `${b}${p}` || "/";
}

const [legislative, newsletter, papers, news, weekly] = await Promise.all([
  getCollection("legislative"),
  getCollection("newsletter"),
  getCollection("papers"),
  getCollection("news"),
  getCollection("weekly"),
]);

function byDateDesc<T extends { data: { date: Date } }>(a: T, b: T): number {
  return new Date(b.data.date).getTime() - new Date(a.data.date).getTime();
}

const sortedLegislative = [...legislative].sort(byDateDesc);
const sortedNewsletter = [...newsletter].sort(byDateDesc);
const sortedPapers = [...papers].sort(byDateDesc);
const sortedNews = [...news].sort(byDateDesc);
const sortedWeekly = [...weekly].sort(byDateDesc);

const latestLegislative = sortedLegislative[0];
const latestNewsletter = sortedNewsletter[0];
const latestPapers = sortedPapers[0];
const latestNews = sortedNews[0];
const latestWeekly = sortedWeekly[0];

const itemCleanup = (s: string): string =>
  s
    .replace(/\[[^\]]*\]\([^)]*\)/g, "") // drop links entirely (trailing source labels are noise in the hero)
    .replace(/[🔴🟡🟢📅💡📚📖🔗🔇🆕🔑🌐📄⚡]/gu, "")
    .replace(/\*\*([^*]+)\*\*/g, "$1")
    .replace(/\bNEW\b/g, "")
    .replace(/\(follow-up[^)]*\)/gi, "")
    .replace(/\(was:[^)]*\)/gi, "")
    .replace(/\s+/g, " ")
    .trim();

function sliceSection(body: string, headingRe: RegExp): string | null {
  const parts = body.split(headingRe);
  if (parts.length < 2) return null;
  const after = parts[1];
  const nextHeadingIdx = after.search(/^##\s+/m);
  return nextHeadingIdx === -1 ? after : after.slice(0, nextHeadingIdx);
}

// Pull up to three headline items for the hero. For the weekly digest, prefer
// the NEED TO KNOW bullets (the digest's own tl;dr); otherwise fall back to the
// ACT NOW → ON THE RADAR → PIPELINE ### items (legislative-style digests).
function extractTopThree(
  entry:
    | CollectionEntry<"weekly">
    | CollectionEntry<"legislative">
    | undefined,
): string[] {
  if (!entry?.body) return [];
  const body = entry.body;
  const titles: string[] = [];

  const needToKnow = sliceSection(body, /^##\s*(?:🔑\s*)?NEED\s*TO\s*KNOW\s*$/im);
  if (needToKnow) {
    const bulletRe = /^\s*[-*]\s+(.+?)\s*$/gm;
    let m: RegExpExecArray | null;
    while ((m = bulletRe.exec(needToKnow)) !== null && titles.length < 3) {
      const cleaned = itemCleanup(m[1]);
      if (cleaned) titles.push(cleaned);
    }
    if (titles.length > 0) return titles;
  }

  const sectionOrder: RegExp[] = [
    /^##\s*(?:🔴\s*)?ACT\s*NOW\s*$/im,
    /^##\s*(?:🟡\s*)?ON\s*THE\s*RADAR\s*$/im,
    /^##\s*(?:🟢\s*)?PIPELINE(?:\s*WATCH)?\s*$/im,
  ];
  for (const re of sectionOrder) {
    if (titles.length >= 3) break;
    const section = sliceSection(body, re);
    if (!section) continue;
    const headingRe = /^###\s+(.+?)\s*$/gm;
    let m: RegExpExecArray | null;
    while ((m = headingRe.exec(section)) !== null && titles.length < 3) {
      titles.push(itemCleanup(m[1]));
    }
  }
  return titles;
}

const heroEntry = latestWeekly ?? latestLegislative;
const topThree = extractTopThree(heroEntry);
const fallbackNote = heroEntry?.data.editor_note ?? null;
const hasAnyDigest = Boolean(
  latestWeekly || latestLegislative || latestNewsletter || latestPapers || latestNews,
);

const latestCards = (
  [latestWeekly, latestLegislative, latestNewsletter, latestPapers, latestNews].filter(
    Boolean,
  ) as Array<
    | CollectionEntry<"weekly">
    | CollectionEntry<"legislative">
    | CollectionEntry<"newsletter">
    | CollectionEntry<"papers">
    | CollectionEntry<"news">
  >
).sort(byDateDesc);
---

<BaseLayout title="SaferAI Policy Tracker" description="Weekly digests of global AI-policy activity, curated by SaferAI.">
  <section class="hero">
    <div class="masthead"><span class="issue-tag">Policy Tracker <strong>V 1.0</strong></span></div>
    <div class="kicker">SaferAI · Weekly</div>
    <h1>Policy Tracker</h1>
    <p class="tagline">
      Weekly reading on legislative, news, research, and newsletter signals in
      global AI policy — curated by the SaferAI policy team.
    </p>
  </section>

  <section aria-labelledby="top-three-heading">
    <div class="top-three">
      <h2 id="top-three-heading">Top 3 this week</h2>
      {
        topThree.length > 0 ? (
          <ol>
            {topThree.map((t) => (
              <li>{t}</li>
            ))}
          </ol>
        ) : fallbackNote ? (
          <p>{fallbackNote}</p>
        ) : (
          <p class="empty">
            No digests yet — the first will appear after the Routines run.
          </p>
        )
      }
    </div>
  </section>

  {
    hasAnyDigest && (
      <section aria-labelledby="latest-heading">
        <h2 id="latest-heading">Latest digests</h2>
        <div class="card-grid card-grid--three">
          {latestCards.map((entry) => (
            <DigestCard entry={entry} />
          ))}
        </div>
        <p style="margin-top:1rem;">
          <a href={withBase("/archive")}>Browse the full archive →</a>
        </p>
      </section>
    )
  }
</BaseLayout>
